# Copie para .env (não versionado): cp .env.example .env

# --- PostgreSQL ---
DB_HOST=localhost
# 5433 para não conflitar com outro Postgres local
DB_PORT=5433
DB_USER=votocerto
DB_PASSWORD=votocerto
DB_NAME=votocerto
DB_LOGGING=false
# Se definido, tem precedência sobre DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# DATABASE_URL=postgres://votocerto:votocerto@localhost:5433/votocerto

# --- API ---
# development/test: schema GraphQL aberto e túnel Cloudflare automático (a URL vai para
# packages/vc-app/.env.local). Qualquer outro valor (stage, production) desliga os dois.
NODE_ENV=development
# TUNNEL=false   # desliga o túnel mesmo em development
# Ordena a busca por popularidade (visualizações + escolhas, 1 por aparelho). false desliga.
# POPULARITY_SORT=true
# Mostra no app o número de visualizações do perfil (olho). false esconde sem nova versão do app.
# VIEW_COUNT_VISIBLE=true
API_PORT=4000
# URL pública da API; usada para montar as URLs das fotos e dos planos de governo.
# No celular (Expo Go), use o IP da máquina na rede, ex.: http://192.168.0.10:4000
PUBLIC_URL=http://localhost:4000
# Origens permitidas no CORS, separadas por vírgula. Vazio = qualquer http://localhost:<porta>.
CORS_ORIGINS=

# --- Termos de uso e política de privacidade (/termos, /privacidade) ---
# Responsável pelo app (nome ou razão social, com CPF/CNPJ se quiser) e e-mail de contato.
# Sem eles, as páginas mostram "[a definir]" em destaque.
LEGAL_CONTROLLER=
LEGAL_CONTACT_EMAIL=
# LEGAL_UPDATED_AT=24 de setembro de 2026

# --- App (Expo) ---
# No celular, `localhost` é o próprio aparelho: use o IP da máquina.
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql
# Links usados na imagem compartilhada da colinha
# EXPO_PUBLIC_SHARE_URL=votocola.app
# EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.votocola.mobile
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/br/app/votocola/id...

# AdMob (sem eles, o app usa os IDs de teste do Google). Os App IDs ficam em packages/vc-app/app.json.
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-xxx/yyy
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=ca-app-pub-xxx/yyy

# --- Resumos dos planos de governo (yarn api import:tse resumos) ---
# ANTHROPIC_API_KEY=
