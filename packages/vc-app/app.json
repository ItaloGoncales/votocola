{
  "expo": {
    "name": "VotoCola",
    "slug": "votocola",
    "scheme": "votocola",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.votocola.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.votocola.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/android-adaptive-monochrome.png",
        "backgroundColor": "#141036"
      },
      "permissions": ["com.google.android.gms.permission.AD_ID"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#141036"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6785676183694375~7554440359",
          "iosAppId": "ca-app-pub-6785676183694375~2054701666",
          "userTrackingUsageDescription": "Usamos esta permissão só para exibir anúncios mais relevantes, que mantêm o VotoCola gratuito. Suas escolhas de candidatos nunca saem do seu celular.",
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ],
      "expo-build-properties",
      "expo-font",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Usamos esta permissão só para exibir anúncios mais relevantes, que mantêm o VotoCola gratuito. Suas escolhas de candidatos nunca saem do seu celular."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#141036",
    "icon": "./assets/brand/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b05c1277-a133-4eb1-be27-eefeb74e2164"
      }
    },
    "owner": "goncalesi"
  }
}
